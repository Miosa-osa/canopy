{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Canopy Desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "notification:default",
    "process:default",
    "shell:default",
    "allow-vault-put",
    "allow-vault-get",
    "allow-vault-delete",
    "allow-runtime-detect",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-kill",
    "allow-list-dir",
    "allow-read-file"
  ]
}
