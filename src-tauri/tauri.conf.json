{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canopy",
  "version": "0.1.0",
  "identifier": "ai.canopy.desktop",
  "build": {
    "frontendDist": "../desktop/build",
    "devUrl": "http://localhost:5280",
    "beforeDevCommand": "pnpm -C ../desktop dev",
    "beforeBuildCommand": "pnpm -C ../desktop build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Canopy",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:9190 http://127.0.0.1:9190 ws://localhost:9190 ws://127.0.0.1:9190; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "store": {},
    "shell": {
      "open": true
    }
  }
}
